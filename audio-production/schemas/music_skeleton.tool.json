{
  "type": "function",
  "function": {
    "name": "submit_music_skeleton",
    "description": "提交一份严格符合 happy_bounce_v01 任务卡的两小节音乐骨架。不得返回课程方案、段落说明或完整歌曲。",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kitId", "feeling", "groove", "bpm", "timeSignature", "key", "bars", "melody", "chords", "bassRoots", "drumGrid", "lionAllowedBeats", "lionNotes"],
      "properties": {
        "kitId": {"type": "string", "const": "happy_bounce_v01"},
        "feeling": {"type": "string", "const": "happy"},
        "groove": {"type": "string", "const": "bounce"},
        "bpm": {"type": "integer", "const": 96},
        "timeSignature": {"type": "string", "const": "4/4"},
        "key": {"type": "string", "const": "C major"},
        "bars": {"type": "integer", "const": 2},
        "melody": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pitch", "beat", "duration", "solfege"],
            "properties": {
              "pitch": {"type": "string"},
              "beat": {"type": "number", "minimum": 0, "maximum": 7.75},
              "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
              "solfege": {"type": "string", "enum": ["do", "re", "mi", "fa", "sol", "la", "si"]}
            }
          }
        },
        "chords": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "bassRoots": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "drumGrid": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "lionAllowedBeats": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 7.75}},
        "lionNotes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pitch", "beat", "duration", "velocity"],
            "properties": {
              "pitch": {"type": "string", "pattern": "^[A-G](#|b)?[4-5]$"},
              "beat": {"type": "number", "minimum": 0, "maximum": 7.75},
              "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
              "velocity": {"type": "integer", "minimum": 45, "maximum": 85}
            }
          }
        }
      }
    }
  }
}
