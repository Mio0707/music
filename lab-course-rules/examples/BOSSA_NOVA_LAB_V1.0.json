  "musicAnalysis": {
    "childSummary": "Bossa Nova 来自巴西。它把桑巴的节奏放轻，再配上温暖的吉他和爵士和弦，听起来像一边散步一边轻轻摇摆。",
    "bpm": 116,
    "bpmMeaning": "这是课堂练习速度，不代表所有 Bossa Nova 都是同一速度。",
    "timeSignature": "4/4",
    "groove": "soft_syncopated_sway",
    "grooveExplanation": "大拍很稳，但有些声音故意落在大拍之间，所以听起来轻轻摇摆。",
    "rhythmElements": [
      {
        "id": "bass_pulse",
        "name": "Bass Pulse",
        "childName": "低音脚步",
        "role": "pulse"
      },
      {
        "id": "guitar_syncopation",
        "name": "Syncopation",
        "childName": "错开大拍的轻拍",
        "role": "accent"
      },
      {
        "id": "soft_shaker",
        "name": "Shaker Subdivision",
        "childName": "连续的沙沙声",
        "role": "subdivision"
      }
    ],
    "signatureElements": [
      {
        "id": "nylon_guitar",
        "name": "Nylon-string Guitar",
        "childName": "温暖的尼龙弦吉他"
      },
      {
        "id": "jazz_color_chords",
        "name": "Jazz Color Chords",
        "childName": "带一点梦幻色彩的和弦"
      }
    ],
    "formIdea": "从一把吉他开始，逐渐加入低音和细碎节奏；中间留出呼吸，再让全体回归。"
  },
